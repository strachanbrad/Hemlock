<component name="PairingScreen" extends="Group">
  <interface>
    <!-- The six digits as the server sends them; shown in two groups of three. -->
    <field id="code" type="string" onChange="render" />
    <field id="address" type="string" onChange="render" />
    <field id="status" type="string" onChange="render" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/PairingScreen.brs" />
  <children>
    <Poster id="umbel" uri="pkg:/images/umbel.png" width="58" height="58" blendColor="0xC9A86AFF" translation="[931, 150]" />
    <Label id="title" translation="[96, 236]" width="1728" horizAlign="center" color="0xEFE6DAFF" text="Pair this TV with Hemlock">
      <Font role="font" uri="pkg:/fonts/CormorantGaramond-SemiBold.otf" size="72" />
    </Label>
    <Rectangle id="codeBox" translation="[610, 380]" width="700" height="210" color="0x262030FF" />
    <Rectangle translation="[610, 380]" width="700" height="2" color="0xC9A86A4D" />
    <Rectangle translation="[610, 588]" width="700" height="2" color="0xC9A86A4D" />
    <Rectangle translation="[610, 380]" width="2" height="210" color="0xC9A86A4D" />
    <Rectangle translation="[1308, 380]" width="2" height="210" color="0xC9A86A4D" />
    <!-- Two labels keep the gap between the groups wide whatever the digits' widths. -->
    <Label id="codeFirst" translation="[610, 380]" width="325" height="210" horizAlign="right" vertAlign="center" color="0xC9A86AFF">
      <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="132" />
    </Label>
    <Label id="codeSecond" translation="[985, 380]" width="325" height="210" horizAlign="left" vertAlign="center" color="0xC9A86AFF">
      <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="132" />
    </Label>
    <Label id="instruction" translation="[96, 640]" width="1728" horizAlign="center" color="0xB8A9A0FF" text="On Hemlock's admin page, under Televisions, type this code">
      <Font role="font" uri="pkg:/fonts/Lora-Italic.ttf" size="38" />
    </Label>
    <Label id="statusText" translation="[96, 730]" width="1728" horizAlign="center" wrap="true" maxLines="2" color="0xEFE6DAFF">
      <Font role="font" uri="pkg:/fonts/Lora-Regular.ttf" size="30" />
    </Label>
    <Label id="addressText" translation="[96, 850]" width="1728" horizAlign="center" color="0x9A8B90FF">
      <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="24" />
    </Label>
  </children>
</component>
